{
  "name": "rbx-css",
  "version": "0.1.0",
  "description": "CSS to Roblox StyleSheet compiler",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "rbx-css": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --external lightningcss",
    "test": "bun test",
    "dev": "bun run src/index.ts"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "lightningcss": "^1.31.1"
  }
}
